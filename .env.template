# ============================================================
# SRE-AI-Agent — Environment Variables Template
# Copy to .env and fill in all values before running scripts.
# NEVER commit .env to git.
# ============================================================

# ── AWS ──────────────────────────────────────────────────────
# IMPORTANT: AWS_ACCOUNT_ID must exactly match your authenticated AWS account.
# Run: aws sts get-caller-identity --query Account --output text
# A mismatch causes ECR push failures and cross-account IAM errors.
AWS_ACCOUNT_ID=<YOUR_12_DIGIT_ACCOUNT_ID>
AWS_REGION=ap-south-1
CLUSTER_NAME=sre-ai-agent-cluster
ECR_REGISTRY=${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com

# ── Amazon Bedrock ────────────────────────────────────────────
# No key needed — uses IRSA role attached to agent pod.
# Set model ID here for easy override.
BEDROCK_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0
BEDROCK_REGION=ap-south-1

# ── Grafana Cloud ─────────────────────────────────────────────
# Create a free stack at grafana.com → get these from stack settings.
GRAFANA_CLOUD_API_KEY=<glc_...>
GRAFANA_CLOUD_PROMETHEUS_URL=<https://prometheus-prod-XX.grafana.net/api/prom/push>
GRAFANA_CLOUD_PROMETHEUS_USER=<numeric-user-id>
GRAFANA_STACK_NAME=<your-stack-name>

# ── CloudWatch Logs ──────────────────────────────────────────
# Log group created automatically by Promtail; set the name here.
CLOUDWATCH_LOG_GROUP=/sre-ai-agent/k8s
CLOUDWATCH_LOG_REGION=ap-south-1

# ── pgvector ─────────────────────────────────────────────────
# Choose any strong password — used only inside the cluster
PG_PASSWORD=<choose-a-strong-password>
PG_USER=postgres
PG_DB=sre_agent

# ── App images (filled after ECR push) ───────────────────────
APP_IMAGE=${ECR_REGISTRY}/sre-ai-agent-app:latest
AGENT_IMAGE=${ECR_REGISTRY}/sre-ai-agent-llm:latest
